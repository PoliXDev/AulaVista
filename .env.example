# Copia este archivo a .env en la raíz del repositorio.
# Clave local: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave-en-local
DEBUG=True
# Vacío en local con DEBUG. En Render: el host del servicio, sin https://
ALLOWED_HOSTS=
# Portal local (Vite en 5180). En producción el primero es https://aulavista.app
# y no se incluye localhost: el logo del panel usa ese primer origen.
CORS_ALLOWED_ORIGINS=http://localhost:5180
# En Render: https://TU-SERVICIO.onrender.com y, si aplica, https://aulavista.app
CSRF_TRUSTED_ORIGINS=
